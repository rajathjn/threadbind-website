---
// Asks once before Google Analytics may set cookies. The choice is stored in localStorage
// ('tb-consent') and read by the Consent Mode default in BaseLayout's Google tag.
---
<section class="consent" aria-label="Cookie choice" hidden data-consent>
  <p><strong>Can we count your visit?</strong> We'd like to use Google Analytics cookies to see how many people visit and which pages they read. No ads, and nothing that follows you to other sites. <a href="/privacy/">Privacy policy</a></p>
  <div class="consent-actions">
    <button type="button" class="btn" data-consent-choice="granted">Accept</button>
    <button type="button" class="btn btn--ghost" data-consent-choice="denied">No thanks</button>
  </div>
</section>

<script>
  declare function gtag(...args: unknown[]): void;
  const banner = document.querySelector<HTMLElement>('[data-consent]')!;
  const read = () => { try { return localStorage.getItem('tb-consent'); } catch { return null; } };
  const show = () => { banner.hidden = false; banner.querySelector<HTMLButtonElement>('[data-consent-choice]')?.focus({ preventScroll: true }); };
  if (!read()) banner.hidden = false;
  banner.querySelectorAll<HTMLButtonElement>('[data-consent-choice]').forEach((button) => {
    button.addEventListener('click', () => {
      const choice = button.dataset.consentChoice as 'granted' | 'denied';
      try { localStorage.setItem('tb-consent', choice); } catch {}
      if (typeof gtag === 'function') gtag('consent', 'update', { analytics_storage: choice });
      banner.hidden = true;
    });
  });
  document.querySelectorAll('[data-cookie-settings]').forEach((el) => el.addEventListener('click', show));
</script>

<style>
  .consent {
    /* A slim bar along the bottom, so it never sits on top of a hero's main button. */
    position: fixed; z-index: 50; left: var(--gutter); right: var(--gutter); bottom: 16px; max-width: 1328px; margin-inline: auto;
    display: flex; align-items: center; justify-content: space-between; gap: 16px 32px; padding: 14px 20px;
    background: var(--holes), var(--forest-deep); color: var(--floss);
    border: 3px dashed var(--saffron);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
  }
  .consent[hidden] { display: none; }
  p { font-size: 16px; line-height: 1.5; }
  p { max-width: 80ch; }
  strong { font-family: var(--font-face); font-weight: 400; font-size: 19px; margin-right: 6px; }
  a { color: var(--saffron); font-weight: 700; }
  .consent-actions { display: flex; flex: none; gap: 12px; }
  .btn { min-height: 46px; padding: 0 22px; font-size: 16px; }
  .btn--ghost { background: transparent; color: var(--floss); box-shadow: inset 0 0 0 2px var(--floss); }
  .btn--ghost:hover { background: rgb(246 235 211 / 0.12); }
  :global(html[data-cloth='cozy']) .consent { background: var(--holes), var(--cozy-800); border-color: var(--cozy-selected); }
  :global(html[data-cloth='cozy']) .consent a { color: var(--cozy-selected); }
  :global(html[data-cloth='cozy']) .consent .btn:not(.btn--ghost) { background: var(--cozy-trace-deep); color: var(--cozy-paper); }
  @media (max-width: 760px) { .consent { flex-direction: column; align-items: stretch; left: 12px; right: 12px; bottom: 12px; } p { font-size: 15px; } }
</style>
