      "css": ".ds-btn-forest{display:inline-flex;align-items:center;min-height:54px;padding:0 28px;background:#0E3A25;color:#F6EBD3;font:800 17px \"Nunito Variable\",Nunito,system-ui,sans-serif;text-decoration:none;border-radius:0;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms}.ds-btn-forest:hover{background:#134A30}.ds-btn-forest:active{transform:scale(.97)}.ds-btn-forest:focus-visible{outline:3px solid #F2B705;outline-offset:3px}"
    },
