      "css": ".ds-tile{position:relative;display:inline-grid;place-items:center;width:56px;height:56px;margin:2px;background:#F9EBD7;color:#023019;border:2px solid #E0D4C2;border-radius:8px;font:800 28px \"Fraunces Soft\",Georgia,serif}.ds-tile small{position:absolute;right:5px;bottom:2px;font:800 11px \"Nunito Variable\",Nunito,system-ui,sans-serif;color:#046A38}.ds-tile.is-traced{background:#F2B8A1;color:#F9EBD7}.ds-tile.is-traced small{color:#023019}"
    }
  ],
  "narrative": {
    "northStar": "The Studio Sampler",
    "overview": "",
    "keyCharacteristics": [
      "Whole-section cloths with a visible hole grid; colour changes happen at section edges.",
      "Stitched 5×7 display lettering; Fraunces Soft headings; Nunito text.",
      "A live loom as the signature: traced cells fill with stitches, the trace is a dashed backstitch.",
      "Flat surfaces, no shadows at rest, square buttons.",
      "One authored motion: top-of-page stitching sews in; the opening trace sews itself and the score counts up."
    ],
    "rules": [
      {
        "name": "The Whole Cloth Rule",
        "body": "A colour that isn't text owns a whole section edge to edge. If a colour would appear as a small accent tile on another cloth, it's the wrong colour.\r",
        "section": "colors"
      },
      {
        "name": "The Cozy Page Rule",
        "body": "Anything inside `html[data-cloth='cozy']` (the Weave page) uses only Cozy tokens, including the header button, nav accent and footer. Saffron and oxblood never appear there.\r",
        "section": "colors"
      },
      {
        "name": "The Large Vermilion Rule",
        "body": "Vermilion (#E8452A / #E34222) on forest falls below 3:1 at text sizes, so it only sets stitched display type or fills. Headings on Cozy forest use salmon instead.\r",
        "section": "colors"
      },
      {
        "name": "The Stitched Heading Rule",
        "body": "Stitched lettering is always either the `<h1>`, with the real title in visually hidden text, or `aria-hidden` decoration beside a real heading. It is never the only copy of meaningful text.\r",
        "section": "typography"
      },
      {
        "name": "The Two Faces Rule",
        "body": "Fraunces Soft and Nunito are the only typefaces. Fraunces appears outside headings only inside game-UI fragments, such as loom tiles.\r",
        "section": "typography"
      },
      {
        "name": "The Fabric Not Shadow Rule",
        "body": "Separate surfaces by changing cloth or tone (forest to forest-deep), never with box-shadow or a hairline border. The cookie banner is the single exception, because it floats over the page.\r",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** give every new section a whole cloth from the palette, with the hole-grid texture.",
      "**Do** set a new page's `<h1>` as stitched lettering with the real title in visually hidden text, and pair it with a Fraunces statement line.",
      "**Do** use Weave's own screens and the live loom as the page's pictures; caption them as in-development renders.",
      "**Do** keep vermilion to display stitching and fills; use cream, sage or rose floss for text on dark cloth.",
      "**Do** honour `prefers-reduced-motion`: all sewing, count-ups and pending threads stop."
    ],
    "donts": [
      "**Don't** add shadows, gradients, glass or hairline borders to separate surfaces; change the cloth instead.",
      "**Don't** add a third typeface, tracked uppercase labels, or a small label above a heading.",
      "**Don't** round buttons or cloths; rounding belongs to game UI fragments only.",
      "**Don't** use saffron or oxblood on the Weave page.",
      "**Don't** animate section entrances; the one motion is stitching at the top of the page and the loom's opening trace."
    ]
  }
}
