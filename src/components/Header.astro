---
import Mark from './Mark.astro';
import { site, nav } from '../site.config';
const path = Astro.url.pathname.replace(/\/?$/, '/');
---
<header class="bar">
  <a class="brand" href="/" aria-label="ThreadBind Studios, home"><Mark size={30} /><span>ThreadBind Studios</span></a>
  <nav class="links" aria-label="Main">
    {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <a class="btn bar-cta" href={site.forms.waitlist} target="_blank" rel="noopener" data-external-form>Join the waitlist</a>
  <details class="menu">
    <summary aria-label="Menu"><span aria-hidden="true"></span>Menu</summary>
    <nav aria-label="Main, mobile">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
  </details>
</header>

<style>
  .bar { position: relative; z-index: 10; display: flex; align-items: center; gap: 32px; padding: 22px var(--gutter); }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--saffron); text-decoration: none; white-space: nowrap; }
  .brand span { color: var(--floss); font-weight: 800; letter-spacing: -0.01em; }
  .links { display: flex; gap: 28px; margin-left: auto; font-weight: 700; }
  .links a, .menu nav a { text-decoration: none; padding: 6px 0; }
  .links a:hover, .links a[aria-current] { text-decoration: underline dashed 2px; text-underline-offset: 8px; color: var(--nav-accent, var(--saffron)); }
  .bar-cta { min-height: 46px; padding: 0 20px; font-size: 16px; white-space: nowrap; }
  .menu { display: none; }
  @media (max-width: 860px) {
    .bar { gap: 14px; padding-block: 16px; }
    .brand span { font-size: 16px; }
    .links { display: none; }
    .bar-cta { margin-left: auto; min-height: 42px; padding: 0 14px; font-size: 15px; }
    .menu { display: block; }
    .menu summary { list-style: none; display: flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 4px; font-weight: 800; cursor: pointer; }
    .menu summary::-webkit-details-marker { display: none; }
    .menu summary span { width: 18px; height: 10px; border-block: 3px dashed currentColor; }
    .menu[open] summary { color: var(--nav-accent, var(--saffron)); }
    .menu nav { position: absolute; left: 0; right: 0; top: 100%; display: none; padding: 8px var(--gutter) 20px; background: var(--holes), var(--forest-deep); font-size: 20px; font-weight: 800; }
    .menu nav a { padding: 12px 0; }
    .menu[open] nav { display: grid; }
  }
  @media (max-width: 520px) { .brand span { display: none; } }
</style>
