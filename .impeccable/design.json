  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action on dark cloth.",
      "html": "<a class=\"ds-btn\" href=\"#\">Join the waitlist</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;min-height:54px;padding:0 28px;background:#F2B705;color:#0E3A25;font:800 17px \"Nunito Variable\",Nunito,system-ui,sans-serif;text-decoration:none;border-radius:0;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms}.ds-btn:hover{background:#FFC92E}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:3px solid #F2B705;outline-offset:3px}"
    },
    {
