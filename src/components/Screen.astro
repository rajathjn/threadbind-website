---
// One game screen. Loads onto its own cloth colour and fades in (see .shot in global.css).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; eager?: boolean; class?: string; sizes?: string; }
const { src, alt, caption, eager = false, class: className, sizes = '(max-width: 900px) 70vw, 360px' } = Astro.props;
---
<figure class:list={['screen', className]}>
  <div class="shot">
    <Picture src={src} alt={alt} widths={[360, 540, 720, 1080]} sizes={sizes} formats={['avif']} fallbackFormat="webp" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screen { margin: 0; }
  .shot { border-radius: clamp(18px, 2.4vw, 28px); overflow: hidden; aspect-ratio: 9 / 16; }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; }
  figcaption { margin-top: 12px; font-size: 15px; opacity: 0.85; }
</style>
