---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../site.config';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  cloth?: 'forest' | 'cozy';
  jsonLd?: Record<string, unknown>;
  /** The hero carries its own waitlist button, so phones drop the header's copy. */
  heroCta?: boolean;
}
const {
  title, description, noindex = false, cloth = 'forest', jsonLd, heroCta = false,
  image = '/og/default.png',
  imageAlt = 'THREADBIND worked in cross-stitch beside the ThreadBind lattice mark on green cloth, over the line: An independent game studio, making Weave.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;
---
<!doctype html>
<html lang="en-GB" data-cloth={cloth} data-hero-cta={heroCta ? '' : undefined}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7149QJJGP9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Consent Mode: no analytics cookies until the visitor accepts (choice kept in localStorage).
      gtag('consent', 'default', { analytics_storage: (function(){ try { return localStorage.getItem('tb-consent') === 'granted' ? 'granted' : 'denied'; } catch (e) { return 'denied'; } })(), ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      gtag('js', new Date());

      gtag('config', 'G-7149QJJGP9');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={cloth === 'cozy' ? '#023019' : '#0E3A25'} />
    <link rel="preload" href="/fonts/Fraunces-SoftExtraBold.ttf" as="font" type="font/ttf" crossorigin />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="leave-thread" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <script>
      const root = document.documentElement;
      root.classList.add('js');

      // Images settle in once decoded; a broken one still shows its cloth and alt text.
      document.querySelectorAll<HTMLImageElement>('.shot img').forEach((img) => {
        const done = () => img.setAttribute('data-loaded', '');
        if (img.complete) done(); else { img.addEventListener('load', done); img.addEventListener('error', done); }
      });

      // External forms open in a new tab: show the button working, then reset.
      document.querySelectorAll<HTMLAnchorElement>('a[data-external-form]').forEach((a) => {
        a.addEventListener('click', () => {
          a.setAttribute('data-pending', '');
          setTimeout(() => a.removeAttribute('data-pending'), 1600);
        });
      });

      // Internal navigation: run a thread along the top while the next page loads.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('a');
        if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || a.target) return;
        const url = new URL(a.href, location.href);
        if (url.origin !== location.origin || (url.pathname === location.pathname && url.hash)) return;
        root.classList.add('is-leaving');
      });
      // Coming back through the history cache should not leave the thread running.
      addEventListener('pageshow', () => root.classList.remove('is-leaving'));
    </script>
    <style is:global>
      .skip { position: absolute; left: 12px; top: -60px; z-index: 200; padding: 10px 16px; background: var(--saffron); color: var(--forest); font-weight: 800; }
      .skip:focus { top: 12px; }
      @media (max-width: 860px) { html[data-hero-cta] .bar-cta { display: none; } html[data-hero-cta] .menu { margin-left: auto; } }
      .nowrap { white-space: nowrap; }
      html[data-cloth='cozy'] body { background: var(--holes), var(--cozy-900); color: var(--cozy-parchment); }
    </style>
  </body>
</html>
