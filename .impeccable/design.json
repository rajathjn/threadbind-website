      "html": "<a class=\"ds-btn-trace\" href=\"#\">Join the waitlist</a>",
      "css": ".ds-btn-trace{display:inline-flex;align-items:center;min-height:54px;padding:0 28px;background:#C83A1E;color:#FCF5EB;font:800 17px \"Nunito Variable\",Nunito,system-ui,sans-serif;text-decoration:none;border-radius:0;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms}.ds-btn-trace:hover{background:#A93018}.ds-btn-trace:active{transform:scale(.97)}.ds-btn-trace:focus-visible{outline:3px solid #F2B8A1;outline-offset:3px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "Wordmark, four links, current page dashed-underlined.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-brand\" href=\"#\">ThreadBind Studios</a><a href=\"#\" aria-current=\"page\">Weave</a><a href=\"#\">Studio</a><a href=\"#\">Press</a><a href=\"#\">Support</a></nav>",
      "css": ".ds-nav{display:flex;gap:28px;align-items:center;padding:22px 32px;background:#0E3A25;color:#F6EBD3;font:700 18px \"Nunito Variable\",Nunito,system-ui,sans-serif}.ds-nav a{color:inherit;text-decoration:none}.ds-nav .ds-brand{font-weight:800;margin-right:auto}.ds-nav a:hover,.ds-nav a[aria-current]{color:#F2B705;text-decoration:underline dashed 2px;text-underline-offset:8px}.ds-nav a:focus-visible{outline:3px solid #F2B705;outline-offset:3px}"
    },
